{
  "name": "monaco-lsp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run ensure:ty-wasm && vite dev",
    "build": "npm run ensure:ty-wasm && vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "build:ty-wasm": "bash scripts/build-ty-wasm.sh",
    "ensure:ty-wasm": "bash scripts/ensure-ty-wasm.sh",
    "test:forms": "node scripts/test-forms.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "tsserver": "node scripts/tsserver-tools.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.168.6",
    "@tanstack/react-start": "^1.168.6",
    "lucide-react": "^1.41.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.2",
    "react-test-renderer": "^19.2.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
