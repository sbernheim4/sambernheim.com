{
  "name": "monaco-lsp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run ensure:ty-wasm && vite dev",
    "build": "npm run ensure:ty-wasm && vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "vite preview",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build:ty-wasm": "bash scripts/build-ty-wasm.sh",
    "ensure:ty-wasm": "bash scripts/ensure-ty-wasm.sh",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "tsserver": "node scripts/tsserver-tools.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src server scripts tests vite.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:tests && npm run typecheck:scripts && npm test"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.168.6",
    "@tanstack/react-start": "^1.168.6",
    "lucide-react": "^1.41.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.5",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "rehype-highlight": "^7.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^5.0.1",
    "wrangler": "^4.129.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
